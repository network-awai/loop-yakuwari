;; yukkuri — ゆっくり解説. Four channels, one steward each.
;;
;; The unit is the CHANNEL, not the series. 4 channels hold 123 series as of
;; 2026-08-19, and a steward per series would be 123 bots on a fleet whose
;; inference plane serves ONE request at a time (murakumo-main reports
;; "parallel":1). The channel is also where the real boundary sits: each one
;; carries its own :channel/topic-scope and its own compliance rule, and
;; those are the editorial decisions.
;;
;; ASYMMETRY, stated rather than smoothed over: yukkuri's own content data
;; describes `cyber` as "the only mature channel". The other three stewards
;; inherit that, and their objectives say so. A steward reporting on a
;; channel with no published episodes should say it has none — not produce a
;; growth analysis of nothing.

[{:yakuwari/id :yukkuri/channel-cyber
  :yakuwari/business :yukkuri
  :yakuwari/project "cloud-itonami/yukkuri"
  :yakuwari/objective
  "Run ゆっくりサイバーch — the only channel this repo's own data calls mature,
   and the only one with a real YouTube presence (UCTisE2aPQp3i8i6JUVIUoiw).
   It is therefore the channel where growth work is measurable rather than
   speculative: read the actual metadata and retention, and propose the one
   change with evidence behind it. Its :channel/topic-scope is explicit —
   security only; quantum, space and trivia belong to misc. Publishing
   outside that scope is a defect even when the episode is good."
  :yakuwari/scale {:min 0 :desired 1 :max 1}
  :yakuwari/runners [{:runner :claude :weight 1}]
  :bot/role :work-steward
  :bot/name "ゆっくりサイバーch"
  :bot/cadence-minutes 1440
  :yakuwari/capabilities
  [{:capability :vf.read :decision :autonomous}
   {:capability :metrics.read :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :content.publish :decision :voice-required
    :note "A published video is not recallable. Scope compliance is checked before, not after."}
   {:capability :patch.integrate :decision :approval-required}
   {:capability :deploy.production :decision :approval-required}]}

 {:yakuwari/id :yukkuri/channel-anime
  :yakuwari/business :yukkuri
  :yakuwari/project "cloud-itonami/yukkuri"
  :yakuwari/objective
  "Run Anime Theory ch. Its compliance boundary is the tightest in the repo
   and is written into the content data itself: commentary and criticism plus
   clearly-labelled speculation — no leaks, no piracy, theories marked as
   theories. Treat that as a gate on every episode, not a disclaimer added at
   the end. It is EN-base with series like Frame Craft and Foreshadow Lab
   defined and a weekly cadence declared; report how many episodes have
   actually shipped against that declared cadence, and if the answer is zero,
   say zero. A declared cadence with no episodes is a plan, not a channel."
  :yakuwari/scale {:min 0 :desired 1 :max 1}
  :yakuwari/runners [{:runner :claude :weight 1}]
  :bot/role :work-steward
  :bot/name "Anime Theory ch"
  :bot/cadence-minutes 1440
  :yakuwari/capabilities
  [{:capability :vf.read :decision :autonomous}
   {:capability :metrics.read :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :content.publish :decision :voice-required}
   {:capability :patch.integrate :decision :approval-required}
   {:capability :deploy.production :decision :approval-required}]}

 {:yakuwari/id :yukkuri/channel-truecrime
  :yakuwari/business :yukkuri
  :yakuwari/project "cloud-itonami/yukkuri"
  :yakuwari/objective
  "Run True Crime ch — the channel whose subjects are REAL PEOPLE, which
   makes it categorically unlike the other three. Victims, the accused and
   the convicted are all living or recently-living identifiable persons, and
   platform policy, defamation exposure and basic decency all bind here
   before editorial quality does. Establish the sourcing and naming rules
   this channel writes to and record them in the repo BEFORE proposing
   episodes. If those rules do not exist yet, producing them is the whole
   job this cycle; an episode shipped ahead of them is the failure mode."
  :yakuwari/scale {:min 0 :desired 1 :max 1}
  :yakuwari/runners [{:runner :claude :weight 1}]
  :bot/role :work-steward
  :bot/name "True Crime ch"
  :bot/cadence-minutes 1440
  :yakuwari/capabilities
  [{:capability :vf.read :decision :autonomous}
   {:capability :metrics.read :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :content.publish :decision :approval-required
    :note "Stricter than the fleet ceiling on purpose. Episodes name real people; a voice check is not enough."}
   {:capability :patch.integrate :decision :approval-required}
   {:capability :deploy.production :decision :approval-required}]}

 {:yakuwari/id :yukkuri/channel-pachinko
  :yakuwari/business :yukkuri
  :yakuwari/project "cloud-itonami/yukkuri"
  :yakuwari/objective
  "Run ゆっくりパチンコ・パチスロch. Gambling content carries platform
   restrictions and an age boundary that the other three channels do not,
   and the honest question this steward owes an answer to is whether the
   channel can be monetised and advertised at all under those rules —
   established BEFORE production volume, because the answer changes whether
   the channel is worth running. Report the restriction as it actually is,
   including when it makes the channel unviable."
  :yakuwari/scale {:min 0 :desired 1 :max 1}
  :yakuwari/runners [{:runner :claude :weight 1}]
  :bot/role :work-steward
  :bot/name "ゆっくりパチンコ・パチスロch"
  :bot/cadence-minutes 1440
  :yakuwari/capabilities
  [{:capability :vf.read :decision :autonomous}
   {:capability :metrics.read :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :content.publish :decision :voice-required}
   {:capability :patch.integrate :decision :approval-required}
   {:capability :deploy.production :decision :approval-required}]}]
