;; Cloud Itonami's product runtime is cloud-itonami-app.  The business record
;; remains network-awai/cloud-itonami, but an Engineer or QA Bot asked to repair
;; the desktop/runtime cannot do that from the business/meta repository.  These
;; three authored roles narrow their filesystem authority to the implementation
;; repository; every other Cloud Itonami role keeps the generated business
;; workspace.

[{:yakuwari/id :cloud-itonami/engineer
  :yakuwari/business :cloud-itonami
  :yakuwari/project "cloud-itonami/cloud-itonami-app"
  :yakuwari/objective
  "Preserve Cloud Itonami resident reliability and capability confinement
   across the desktop UI, CLI and MCP. Reproduce the highest current runtime
   blocker in cloud-itonami-app, then deliver or propose the smallest verified
   repair without widening a Bot's authority."
  :yakuwari/scale {:min 0 :desired 1 :max 3
                   :scale-up-on {:queue-depth 2 :blocker-count 1}}
  :yakuwari/runners [{:runner :codex :weight 2}
                     {:runner :claude :weight 1}]
  ;; Instruction only. Cloud Itonami loads this governed package into the
  ;; Engineer's system context; it never becomes a tool or capability grant.
  :bot/skills [:itonami-bot-readiness]
  :yakuwari/capabilities
  [{:capability :issue.triage :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :patch.integrate :decision :approval-required}
   {:capability :deploy.production :decision :approval-required}
   {:capability :incident.respond :decision :autonomous}]}

 {:yakuwari/id :cloud-itonami/qa
  :yakuwari/business :cloud-itonami
  :yakuwari/project "cloud-itonami/cloud-itonami-app"
  :yakuwari/objective
  "Try to falsify Cloud Itonami desktop, resident, CLI and MCP release claims
   from the cloud-itonami-app repository. Reproduce capability-admission drift
   independently, record the smallest counterexample, and block promotion when
   offered tools are neither runnable nor explicitly governed."
  :yakuwari/scale {:min 0 :desired 1 :max 2
                   :scale-up-on {:blocker-count 1}}
  :yakuwari/runners [{:runner :codex :weight 1}]
  :yakuwari/capabilities
  [{:capability :metrics.read :decision :autonomous}
   {:capability :test.run :decision :autonomous}
   {:capability :issue.create :decision :autonomous}
   {:capability :patch.create :decision :autonomous}
   {:capability :release.block :decision :autonomous}
   {:capability :deploy.production :decision :blocked}]}

 {:yakuwari/id :cloud-itonami/disk-maintainer
  :yakuwari/business :cloud-itonami
  :yakuwari/project "cloud-itonami/cloud-itonami-app"
  :yakuwari/objective
  "Keep this Mac above the resident 20 GiB free-space floor. Observe the data
   volume first and call the fixed cleanup only under pressure. If pressure
   remains, inventory only the fixed temporary/cache roots plus the aggregate
   resident-release footprint, reclaim only fresh bounded candidate IDs
   classified as regenerable, and report stable
   before/after bytes. Never accept a raw path or shell. Never delete
   repositories, Git history, worktrees, sessions, memories, documents,
   databases, DataLad, browser profiles, Docker data, resident releases,
   installed toolchains, or review-required model artifacts."
  :yakuwari/scale {:min 1 :desired 1 :max 1}
  :yakuwari/runners [{:runner :codex :weight 1}]
  :bot/role :operations
  :bot/name "Disk Maintainer"
  :bot/cadence-minutes 15
  :yakuwari/capabilities
  [{:capability :disk.inspect :decision :autonomous}
   {:capability :disk.cleanup :decision :autonomous
    :note "Only the reviewed disk-space-cleanup helper's fixed allowlist; no arbitrary path or shell."}
   {:capability :disk.candidate.inspect :decision :autonomous
    :note "Read-only inventory of fixed temporary/cache roots plus aggregate resident-release bytes; receipts carry IDs, not paths, and releases remain review-required."}
   {:capability :disk.reclaimable.cleanup :decision :autonomous
    :note "Pressure-only, at most 8 fresh receipt IDs and 10 GiB; tracked Git/open/stale/model artifacts fail closed. Worktree dependencies require git-ignored plus zero tracked files."}]}

 {:yakuwari/id :cloud-itonami/domain-steward
  :yakuwari/business :cloud-itonami
  :yakuwari/project "cloud-itonami/cloud-itonami-app"
  :yakuwari/objective
  "Operate Cloud Itonami's agent-first domain portfolio as one bounded cycle:
   inspect registrations, DNS and pending proposals; execute only a proposal
   already approved by human Passkey; otherwise surface renewal risk or prepare
   at most one exact registration, auto-renew or DNS proposal from current
   provider evidence. Never invent demand, buy speculatively, change nameservers,
   bypass Passkey, or treat a proposal as an external effect."
  :yakuwari/scale {:min 1 :desired 1 :max 1}
  :yakuwari/runners [{:runner :codex :weight 1}]
  :bot/role :operations
  :bot/name "Domain Steward"
  :bot/cadence-minutes 15
  :yakuwari/capabilities
  [{:capability :domain.read :decision :autonomous}
   {:capability :domain.proposal.create :decision :autonomous
    :note "Creates an internal proposal only; registration, renewal billing and DNS mutation still require Passkey."}
   {:capability :domain.approved-proposal.commit :decision :autonomous
    :note "The host refuses commit unless authority.api records human Passkey approval for this exact proposal."}]}

 ;; Measured 2026-08-30 across 4,696 checkouts under orgs/: zero interrupted
 ;; merges or rebases, six repositories holding stashes, 791 live linked
 ;; worktrees, and 80 worktree registrations in 65 repositories whose working
 ;; tree had already been deleted. The last row is the only one a fixed verb
 ;; can finish, and it is the one nothing was reading -- `ls` does not show a
 ;; registration whose directory is gone, and `git status` in one checkout
 ;; says nothing about the other four thousand.
 ;;
 ;; Cadence 60 rather than the shared 15: stale registrations accumulate over
 ;; days, and the run takes a resident slot even though it crosses no model
 ;; provider. Read it as a ceiling like every other cadence here.
 {:yakuwari/id :cloud-itonami/git-maintainer
  :yakuwari/business :cloud-itonami
  :yakuwari/project "cloud-itonami/cloud-itonami-app"
  :yakuwari/objective
  "Keep git bookkeeping across the west workspace from accumulating. Read
   hygiene across every west-registered checkout, then prune ONLY the
   registrations of working trees that are already gone. Report interrupted
   merges and rebases, stashes, and anything left unpruned as findings for the
   human runbook (manifest/cleanup-workflow.edn) and do not attempt to resolve
   them: resolving a conflict is a judgement about content, and retiring a
   stash or a branch requires archiving, push and a server-side merge that
   this identity has neither the network nor the credential for. Never drop a
   stash, delete a branch, discard uncommitted work, rebase, force, or push.
   Never override a locked worktree: git's refusal to prune one is what
   protects a working tree on removable media."
  :yakuwari/scale {:min 1 :desired 1 :max 1}
  :yakuwari/runners [{:runner :claude :weight 1}]
  :bot/role :operations
  :bot/name "Git Maintainer"
  :bot/cadence-minutes 60
  :yakuwari/capabilities
  [{:capability :git.inspect :decision :autonomous}
   {:capability :git.cleanup :decision :autonomous
    :note "Only `git worktree prune`, and only in checkouts whose stale registrations were re-measured at call time. No path, no shell, no push."}]}]
